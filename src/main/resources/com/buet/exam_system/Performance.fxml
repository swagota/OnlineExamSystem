<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.chart.BarChart?>
<?import javafx.scene.chart.CategoryAxis?>
<?import javafx.scene.chart.NumberAxis?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="600.0" prefWidth="900.0" style="-fx-background-color: #f0f4ff;" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.buet.exam_system.PerformanceController">

    <AnchorPane layoutX="0.0" layoutY="0.0" prefHeight="70.0" prefWidth="900" style="-fx-background-color: #1a2a4a;">
        <Label layoutX="30.0" layoutY="18.0" style="-fx-text-fill: white; -fx-font-size: 24px; -fx-font-weight: bold;" text="EXAMORA" />
        <Label layoutX="368.0" layoutY="22.0" style="-fx-text-fill: #6a9ae7; -fx-font-size: 18px; -fx-font-weight: bold;" text="📊 My Performance" />
        <Button fx:id="backBtn" layoutX="800" layoutY="17.0" onAction="#handleBack" prefHeight="35.0" prefWidth="80.0" style="-fx-background-color: #6a9ae7; -fx-text-fill: white; -fx-font-size: 13px; -fx-background-radius: 8px; -fx-cursor: hand;" text="← Back" />
    </AnchorPane>

    <HBox layoutX="20.0" layoutY="90.0" spacing="15.0">

        <AnchorPane prefHeight="90.0" prefWidth="190.0" style="-fx-background-color: white; -fx-background-radius: 12px; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 8, 0, 0, 2);">
            <Label layoutX="15.0" layoutY="12.0" style="-fx-text-fill: #888; -fx-font-size: 12px;" text="Total Exams Taken" />
            <Label fx:id="totalExamsCard" layoutX="15.0" layoutY="35.0" style="-fx-text-fill: #1a2a4a; -fx-font-size: 28px; -fx-font-weight: bold;" text="0" />
            <Label layoutX="15.0" layoutY="68.0" style="-fx-text-fill: #6a9ae7; -fx-font-size: 11px;" text="📋 exams completed" />
        </AnchorPane>

        <AnchorPane prefHeight="90.0" prefWidth="190.0" style="-fx-background-color: white; -fx-background-radius: 12px; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 8, 0, 0, 2);">
            <Label layoutX="15.0" layoutY="12.0" style="-fx-text-fill: #888; -fx-font-size: 12px;" text="Average Score" />
            <Label fx:id="avgScoreCard" layoutX="15.0" layoutY="35.0" style="-fx-text-fill: #2ecc71; -fx-font-size: 28px; -fx-font-weight: bold;" text="0%" />
            <Label layoutX="15.0" layoutY="68.0" style="-fx-text-fill: #2ecc71; -fx-font-size: 11px;" text="📈 overall average" />
        </AnchorPane>

        <AnchorPane prefHeight="90.0" prefWidth="190.0" style="-fx-background-color: white; -fx-background-radius: 12px; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 8, 0, 0, 2);">
            <Label layoutX="15.0" layoutY="12.0" style="-fx-text-fill: #888; -fx-font-size: 12px;" text="Best Score" />
            <Label fx:id="bestScoreCard" layoutX="15.0" layoutY="35.0" style="-fx-text-fill: #f39c12; -fx-font-size: 28px; -fx-font-weight: bold;" text="0%" />
            <Label layoutX="15.0" layoutY="68.0" style="-fx-text-fill: #f39c12; -fx-font-size: 11px;" text="🏆 personal best" />
        </AnchorPane>

        <AnchorPane prefHeight="90.0" prefWidth="190.0" style="-fx-background-color: white; -fx-background-radius: 12px; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 8, 0, 0, 2);">
            <Label layoutX="15.0" layoutY="12.0" style="-fx-text-fill: #888; -fx-font-size: 12px;" text="Pass Rate" />
            <Label fx:id="passRateCard" layoutX="15.0" layoutY="35.0" style="-fx-text-fill: #9b59b6; -fx-font-size: 28px; -fx-font-weight: bold;" text="0%" />
            <Label layoutX="15.0" layoutY="68.0" style="-fx-text-fill: #9b59b6; -fx-font-size: 11px;" text="✅ pass rate (≥50%)" />
        </AnchorPane>

    </HBox>


    <HBox layoutX="20.0" layoutY="200.0" spacing="10.0">
        <Label style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #1a2a4a; -fx-padding: 5 0 0 0;" text="Filter:" />
        <ComboBox fx:id="filterCombo" onAction="#handleFilter" prefHeight="30.0" prefWidth="150.0" style="-fx-background-color: white; -fx-border-color: #6a9ae7; -fx-border-radius: 6px; -fx-background-radius: 6px;" />
    </HBox>


    <AnchorPane layoutX="20.0" layoutY="245.0" prefHeight="320.0" prefWidth="530.0" style="-fx-background-color: white; -fx-background-radius: 12px; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 8, 0, 0, 2);">
        <Label layoutX="20.0" layoutY="15.0" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #1a2a4a;" text="📊 Score per Exam (%)" />
        <BarChart fx:id="scoreBarChart" layoutX="10.0" layoutY="35.0" prefHeight="270.0" prefWidth="510.0" style="-fx-background-color: transparent;">
            <xAxis>
                <CategoryAxis fx:id="barXAxis" label="Exam" />
            </xAxis>
            <yAxis>
                <NumberAxis fx:id="barYAxis" label="Score %" lowerBound="0" tickUnit="20" upperBound="100" />
            </yAxis>
        </BarChart>
    </AnchorPane>


    <AnchorPane layoutX="570.0" layoutY="245.0" prefHeight="320.0" prefWidth="310.0" style="-fx-background-color: white; -fx-background-radius: 12px; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 8, 0, 0, 2);">
        <Label layoutX="20.0" layoutY="15.0" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #1a2a4a;" text="🕐 Recent Results" />
        <VBox fx:id="recentResultsBox" layoutX="10.0" layoutY="45.0" prefWidth="290.0" spacing="8.0" />
    </AnchorPane>

</AnchorPane>
